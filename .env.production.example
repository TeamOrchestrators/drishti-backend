# Copy this file to .env.production on the EC2 host. Do not commit the real
# file and do not put credentials into Docker Compose.
# Pooled Neon URL used by the long-running API.
DB_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
# Direct Neon URL used only by Docker's one-shot Goose migration container.
GOOSE_DBSTRING=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# Leave blank until the Python analytics service is deployed. It will later be
# changed to http://analytics:8000, the private Docker service hostname.
INVENTORY_MICROSERVICE_URL=
